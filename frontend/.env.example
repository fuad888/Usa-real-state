# Sol & Stone — Next.js frontend (spec §15)

NEXT_PUBLIC_DJANGO_API_URL=http://localhost:8000/api
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8001

# Optional, server-side only (no NEXT_PUBLIC_ prefix — never reaches the
# browser bundle). Only needed when the frontend runs in a container that
# can't reach the URLs above, e.g. docker-compose sets these to the
# Docker-network service names (http://django:8000/api, http://fastapi:8001)
# so Server Components can fetch across containers. Leave unset for local dev.
DJANGO_API_INTERNAL_URL=
FASTAPI_INTERNAL_URL=

# Used for canonical URLs, sitemap.xml and robots.txt
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Left empty in the demo — MapView draws its own basemap when there is
# no token, so nothing breaks (see frontend/lib/geo.ts).
NEXT_PUBLIC_MAPBOX_TOKEN=
