# Sol & Stone — Django core backend (spec §15)
# Copy to .env and fill in. Never commit real values.

# Demo runs on SQLite when this is unset.
# Production: postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=

DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Phase 1 — media moves off the local filesystem (spec §19)
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_BUCKET=

# Phase 2 — real notifications instead of console logging
SENDGRID_API_KEY=
TWILIO_SID=
TWILIO_TOKEN=
